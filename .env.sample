APP_ENV=development
LOG_LEVEL=debug
PORT=8000
# Production uses credentialed CORS, so wildcard (*) origins are rejected.
# Use a comma-separated allowlist of trusted browser origins, or leave empty to disable CORS.
CORS_ORIGIN=http://localhost:3000
INSTANCE_ID=

# 0 disables proxy trust. A positive integer trusts that many proxy hops.
# The bundled Nginx topology uses exactly one trusted hop.
# For production ingress, prefer an explicit trusted proxy address/CIDR when practical.
TRUST_PROXY=0
HTTP_BODY_LIMIT_BYTES=1048576
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_CONNECTION_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
DEPENDENCY_CHECK_TIMEOUT_MS=2000

# Database settings are required only by processes that import DatabaseModule.
# DB_SYNC is rejected when APP_ENV=production; production schema changes must use migrations.
DATABASE_URL=postgresql://startkit:startkit@localhost:5432/startkit
DB_DEBUG=0
DB_SYNC=0
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000

# Redis is required by both the API rate limiter and Bull workers.
REDIS_URL=redis://localhost:6379/0
REDIS_FAMILY=0
RATE_LIMIT_MAX=600
RATE_LIMIT_TTL_SECONDS=60
# 0: Redis outage makes API unready and rate-limited endpoints return 503.
# 1: API remains ready during Redis outage and reports Redis as degraded.
RATE_LIMIT_FAIL_OPEN=0

WORKER_CONCURRENCY=10
