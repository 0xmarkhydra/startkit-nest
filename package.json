{
  "name": "startkit-nest",
  "version": "1.0.0",
  "description": "Production-minded NestJS starter kit with Fastify, horizontally scalable API and workers, PostgreSQL, Redis, queues, logging, and testing.",
  "author": "0xmarkhydra",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "start:worker:dev": "nest start --watch --entryFile worker",
    "start:worker:prod": "node dist/worker.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:load": "node test/load-smoke.mjs",
    "migration:show": "pnpm run build && node scripts/typeorm-cli.mjs migration:show",
    "migration:run": "pnpm run build && node scripts/typeorm-cli.mjs migration:run",
    "migration:revert": "pnpm run build && node scripts/typeorm-cli.mjs migration:revert",
    "migration:generate": "pnpm run build && node scripts/typeorm-cli.mjs migration:generate",
    "migration:create": "node scripts/typeorm-cli.mjs migration:create",
    "check": "pnpm run lint && pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@nestjs/bull": "^10.0.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-fastify": "^10.0.0",
    "@nestjs/swagger": "^7.0.4",
    "@nestjs/typeorm": "^10.0.0",
    "bull": "^4.11.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "ioredis": "^5.3.2",
    "nestjs-pino": "^4.1.0",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "pino-pretty": "^11.2.2",
    "prettier": "^3.3.2",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@/api$": "<rootDir>/modules/api/index",
      "^@/api/(.*)$": "<rootDir>/modules/api/$1",
      "^@/database$": "<rootDir>/modules/database/index",
      "^@/database/(.*)$": "<rootDir>/modules/database/$1",
      "^@/shared/(.*)$": "<rootDir>/shared/$1",
      "^@/worker/(.*)$": "<rootDir>/modules/worker/$1",
      "^@/queue/(.*)$": "<rootDir>/modules/queue/$1",
      "^@/redis/(.*)$": "<rootDir>/modules/redis/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
